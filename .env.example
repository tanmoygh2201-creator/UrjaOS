# ── Supabase ────────────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
# The URL looks like: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The public "anon" key. Safe to expose in the browser — Row Level Security
# (RLS) is what actually protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI Provider (used from Phase 10 — AI Copilot) ───────────────────────────
# Server-side only. NEVER expose an AI key with the NEXT_PUBLIC_ prefix.
# Provider-agnostic: works with OpenAI, Google Gemini, Groq, etc.
AI_API_KEY=

# Which provider to call (e.g. "openai"). Default used by the AI lib.
AI_PROVIDER=openai

# Optional model override (e.g. a specific NVIDIA NIM catalog model).
AI_MODEL=

# Optional endpoint override for any OpenAI-compatible chat server (vLLM, Ollama, …).
AI_BASE_URL=

# ── Image Generation (optional — Copilot "Generate Visual" raster illustrations)
# Any OpenAI-compatible images endpoint. Leave both blank to disable raster
# generation — the Copilot still produces SVG diagrams without these.
AI_IMAGE_BASE_URL=
AI_IMAGE_API_KEY=

# Optional raster model + size (defaults: gpt-image-1, 1024x1024).
AI_IMAGE_MODEL=
AI_IMAGE_SIZE=
